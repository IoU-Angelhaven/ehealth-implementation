---
import { url } from '../lib/url';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ModelOverview from '../components/ModelOverview.astro';
import StoryCard from '../components/StoryCard.astro';
import Facts from '../components/Facts.astro';
import Icon from '../components/Icon.astro';
import Illustration from '../components/Illustration.astro';
import { site } from '../site.config';

const home = await getEntry('pages', 'home');
const about = await getEntry('pages', 'about');
if (!home || !about) throw new Error('Missing src/content/pages/home.md or about.md');
const { Content } = await render(home);
const stories = (await getCollection('stories', (s) => s.data.published)).slice(0, 3);
---

<Base bare>
  <PageHero eyebrow={`Interreg South Baltic project ${site.project}`} title={home.data.title} lead={home.data.intro}>
    <p class="actions">
      <a class="button" href={url('/model/')}>Explore the AMBeR Model</a>
      <a class="button ghost" href={url('/local-guide/')}>Create your local guide</a>
    </p>
    <Illustration slot="art" name="board" />
  </PageHero>

  <section class="section soft">
    <div class="wrap">
      <span class="eyebrow">The AMBeR Model</span>
      <h2>Five phases of implementing eHealth</h2>
      <div class="prose"><Content /></div>
      <ModelOverview />
      <p class="actions">
        <a class="button" href={url('/model/')}>See all activities</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Who is this for?</span>
      <h2>Knowledge for everyone involved in health care</h2>
      <ul class="grid audiences">
        <li class="card">
          <Icon name="heart" size={64} />
          <h3><a href={url('/model/')}>Healthcare professionals</a></h3>
          <p>Practical activities, tips and examples for introducing eHealth in everyday health care.</p>
        </li>
        <li class="card">
          <Icon name="clipboard" size={64} accent="orange" />
          <h3><a href={url('/local-guide/')}>Managers</a></h3>
          <p>How to plan, lead and follow up an eHealth implementation in your organisation.</p>
        </li>
        <li class="card">
          <Icon name="chart" size={64} />
          <h3><a href={url('/stories/')}>Decision-makers</a></h3>
          <p>Results and experiences from implementation in the South Baltic region.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div>
        <span class="eyebrow">From model to practice</span>
        <h2>Create your own local implementation guide</h2>
        <p>
          Every AMBeR partner adapted the generic model to its own organisation. Download the model and
          follow our step-by-step advice – including tips on using AI – to do the same.
        </p>
        <p class="actions"><a class="button" href={url('/local-guide/')}>Get started</a></p>
      </div>
      <div class="art"><Illustration name="guide" /></div>
    </div>
  </section>

  {
    stories.length > 0 && (
      <section class="section soft">
        <div class="wrap">
          <span class="eyebrow">Stories of implementation</span>
          <h2>Experiences from the AMBeR partners</h2>
          <ul class="grid">
            {stories.map((story) => (
              <StoryCard story={story} />
            ))}
          </ul>
          <p class="actions">
            <a class="button ghost" href={url('/stories/')}>All stories</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">About the project</span>
      <h2>{about.data.title}</h2>
      {about.data.intro && <p class="prose lead">{about.data.intro}</p>}
      <p class="prose"><strong>{site.fundingStatement}</strong></p>
      <Facts facts={about.data.facts} />
      <a class="button" href={url('/about/')}>Read more about AMBeR</a>
    </div>
  </section>
</Base>

<style>
  .audiences {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .audiences .card {
    gap: 0.25rem;
  }
  .audiences h3 {
    margin-top: 1.25rem;
  }
</style>
