---
import { url } from '../lib/url';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ModelOverview from '../components/ModelOverview.astro';
import StoryCard from '../components/StoryCard.astro';
import Facts from '../components/Facts.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../icons';
import Illustration from '../components/Illustration.astro';
import { site } from '../site.config';

const home = await getEntry('pages', 'home');
const about = await getEntry('pages', 'about');
if (!home || !about) throw new Error('Missing src/content/pages/home.md or about.md');
const { Content } = await render(home);
const stories = (await getCollection('stories', (s) => s.data.published)).slice(0, 3);

// "Who is this for?": the audiences and the activities each of them can start with.
// The links are looked up in the activity collection, so the build fails loudly if an activity is renamed or removed.
const allActivities = await getCollection('activities');
const phaseCount = (await getCollection('steps')).length;
const activityCount = allActivities.length;
const activityLink = (id: string, label: string) => {
  const a = allActivities.find((x) => x.id === id);
  if (!a) throw new Error(`Start page: unknown activity "${id}"`);
  return { label, href: url(`/model/${a.data.step.id}/${a.id}/`) };
};
const audiences: {
  name: string;
  icon: IconName;
  accent: 'blue' | 'orange';
  text: string;
  uses: { label: string; href: string }[];
}[] = [
  {
    name: 'Healthcare developers',
    icon: 'heart',
    accent: 'blue',
    text: 'Practical activities, tips and examples for introducing eHealth in everyday healthcare.',
    uses: [
      activityLink('1-3-map-the-current-care-process', 'Map the current care process'),
      activityLink('2-4-test-and-learn', 'Test ideas early and learn'),
      activityLink('3-6-pilot-testing', 'Plan and run a pilot'),
    ],
  },
  {
    name: 'Managers',
    icon: 'clipboard',
    accent: 'orange',
    text: 'How to plan, lead and follow up an eHealth implementation in your organisation.',
    uses: [
      activityLink('1-1-secure-approval-and-resources', 'Secure approval and resources'),
      activityLink('3-7-change-management', 'Manage change in your organisation'),
      activityLink('4-6-set-up-leadership-and-decision-making', 'Set up leadership and decision-making'),
    ],
  },
  {
    name: 'Decision-makers',
    icon: 'chart',
    accent: 'blue',
    text: 'Results and experiences from implementation in the South Baltic region.',
    uses: [
      activityLink('4-5-describe-the-value', 'Describe the value of a solution'),
      activityLink('4-3-plan-for-spreading-the-solution', 'Plan for spreading it to more units'),
      activityLink('5-1-collect-and-analyse-data', 'Follow up with data'),
    ],
  },
];
---

<Base bare>
  <PageHero eyebrow={`Interreg South Baltic project ${site.project}`} title={home.data.title} lead={home.data.intro}>
    <p class="actions">
      <a class="button" href={url('/model/')}>Explore the implementation model</a>
      <a class="button ghost" href={url('/local-guide/')}>Create your local guide</a>
    </p>
    <Illustration slot="art" name="board" />
  </PageHero>

  <section class="section soft">
    <div class="wrap">
      <span class="eyebrow">The implementation model</span>
      <h2>Five phases of implementing eHealth</h2>
      <div class="prose"><Content /></div>
      <ModelOverview />
      <p class="actions">
        <a class="button" href={url('/model/')}>See all activities</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Who is this for?</span>
      <h2>A practical model for everyone involved in implementing eHealth</h2>
      <div class="what-is-it">
        <p>
          The implementation model is a practical guide for taking an eHealth solution from idea to everyday
          practice. It describes five phases and {activityCount} activities, each with a checklist, methods and
          tools, and example prompts for an AI assistant. The model builds on implementation science, the
          experience from the AMBeR pilots and service design.
        </p>
        <ul class="stats">
          <li><strong>{phaseCount}</strong> phases</li>
          <li><strong>{activityCount}</strong> activities</li>
          <li>Checklists, methods &amp; AI prompts</li>
        </ul>
      </div>
      <ul class="grid audiences">
        {
          audiences.map((a) => (
            <li class="card audience">
              <Icon name={a.icon} size={64} accent={a.accent} />
              <h3>{a.name}</h3>
              <p>{a.text}</p>
              <span class="use-label">Use it to</span>
              <ul class="use-list">
                {a.uses.map((u) => (
                  <li>
                    <a href={u.href}>{u.label}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div>
        <span class="eyebrow">From model to practice</span>
        <h2>Create your own local implementation guide</h2>
        <p>
          Every AMBeR partner adapted the generic model to its own organisation in order to improve and
          support future implementations. Download the model and follow our step-by-step advice – to do
          the same.
        </p>
        <p class="actions"><a class="button" href={url('/local-guide/')}>Get started</a></p>
      </div>
      <div class="art"><Illustration name="guide" /></div>
    </div>
  </section>

  {
    stories.length > 0 && (
      <section class="section soft">
        <div class="wrap">
          <span class="eyebrow">Stories of implementation</span>
          <h2>Experiences from the AMBeR partners</h2>
          <ul class="grid">
            {stories.map((story) => (
              <StoryCard story={story} />
            ))}
          </ul>
          <p class="actions">
            <a class="button ghost" href={url('/stories/')}>All stories</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">About the project</span>
      <h2>{about.data.title}</h2>
      {about.data.intro && <p class="prose lead">{about.data.intro}</p>}
      <p class="prose"><strong>{site.fundingStatement}</strong></p>
      <Facts facts={about.data.facts} />
      <a class="button" href={url('/about/')}>Read more about AMBeR</a>
    </div>
  </section>
</Base>

<style>
  .what-is-it {
    max-width: 48rem;
  }
  .what-is-it p {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 300;
    color: var(--ink);
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .stats li {
    background: var(--blue-tint);
    color: var(--blue);
    border-radius: 999px;
    padding: 0.3rem 0.95rem;
    font-size: 0.9rem;
  }
  .stats strong {
    font-size: 1.15rem;
    margin-right: 0.15rem;
  }
  .audiences {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .audience {
    gap: 0;
    padding-top: 2rem;
  }
  .audience:has(a:hover) {
    outline: none; /* the whole card is not a link here, only the list items */
  }
  .audience h3 {
    font-size: 1.2rem;
    margin: 0.9rem 0 0.35rem;
  }
  .audience > p {
    margin: 0 0 1rem;
    font-size: 0.97rem;
    color: var(--muted);
  }
  .use-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--orange-text);
  }
  .use-list {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .use-list li {
    position: relative;
    padding-left: 1.35rem;
    font-size: 0.97rem;
  }
  .use-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--orange-text);
    font-weight: 700;
  }
</style>
