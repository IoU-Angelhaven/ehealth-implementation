---
import { getCollection, getEntries, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const stories = await getCollection('stories', (s) => s.data.published);
  return stories.map((story) => ({ params: { id: story.id }, props: { story } }));
}

interface Props {
  story: CollectionEntry<'stories'>;
}

const { story } = Astro.props;
const { Content } = await render(story);
const steps = (await getEntries(story.data.steps)).sort((a, b) => a.data.number - b.data.number);
---

<Base bare title={story.data.title} description={story.data.summary}>
  <PageHero eyebrow={`${story.data.country} · ${story.data.organisation}`} title={story.data.title} lead={story.data.summary}>
    <p class="breadcrumb" slot="breadcrumb"><a href="/stories/">Stories of implementation</a></p>
    {
      story.data.image ? (
        <img slot="art" class="hero-img" src={story.data.image} alt={story.data.imageAlt ?? ''} />
      ) : (
        <Icon slot="art" name="chat" size={200} accent="orange" />
      )
    }
  </PageHero>

  <div class="wrap body">
    <article class="prose">
      {
        story.data.video && (
          <p>
            <a class="button" href={story.data.video}>
              Watch the video
            </a>
          </p>
        )
      }
      <Content />
      {
        steps.length > 0 && (
          <>
            <span class="label">Phases of the AMBeR Model in this story</span>
            <p>
              {steps.map((s) => (
                <a class="tag" href={`/model/${s.id}/`}>
                  Phase {s.data.number}: {s.data.title}
                </a>
              ))}
            </p>
          </>
        )
      }
    </article>
  </div>
</Base>

<style>
  .body {
    padding-top: 3.5rem;
  }
  .hero-img {
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
</style>
