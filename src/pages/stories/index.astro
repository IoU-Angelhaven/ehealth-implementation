---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import StoryCard from '../../components/StoryCard.astro';
import Icon from '../../components/Icon.astro';

const stories = await getCollection('stories', (s) => s.data.published);
---

<Base
  bare
  title="Stories of implementation"
  description="Experiences from implementing eHealth in healthcare in the South Baltic region."
>
  <PageHero
    eyebrow="In practice"
    title="Stories of implementation"
    lead="Successful implementation is about daring to try, learning from what happens and changing the approach until it fits. Here are some examples of such stories from the AMBeR project."
  >
    <Icon slot="art" name="chat" size={200} accent="orange" />
  </PageHero>
  <section class="section soft">
    <div class="wrap">
      <ul class="grid grid-wide">
        {stories.map((story) => <StoryCard story={story} />)}
      </ul>
    </div>
  </section>
</Base>
