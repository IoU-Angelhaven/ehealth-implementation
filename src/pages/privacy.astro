---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Facts from '../components/Facts.astro';

const page = await getEntry('pages', 'privacy');
if (!page) throw new Error('Missing src/content/pages/privacy.md');
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.intro}>
  <PageHero slot="hero" title={page.data.title} lead={page.data.intro} />
  <Facts facts={page.data.facts} />
  <article class="prose">
    <Content />
  </article>
</Base>
