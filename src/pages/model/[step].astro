---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import StoryCard from '../../components/StoryCard.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../icons';

export async function getStaticPaths() {
  const steps = (await getCollection('steps')).sort((a, b) => a.data.number - b.data.number);
  return steps.map((step, i) => ({
    params: { step: step.id },
    props: { step, prev: steps[i - 1], next: steps[i + 1] },
  }));
}

interface Props {
  step: CollectionEntry<'steps'>;
  prev?: CollectionEntry<'steps'>;
  next?: CollectionEntry<'steps'>;
}

const { step, prev, next } = Astro.props;
const { Content } = await render(step);
const activities = (await getCollection('activities', (a) => a.data.step.id === step.id)).sort(
  (a, b) => a.data.order - b.data.order,
);
const stories = await getCollection(
  'stories',
  (s) => s.data.published && s.data.steps.some((ref) => ref.id === step.id),
);
---

<Base bare title={`Step ${step.data.number}: ${step.data.title}`} description={step.data.summary}>
  <PageHero eyebrow={`Step ${step.data.number} of 5`} title={step.data.title} lead={step.data.summary}>
    <p class="breadcrumb" slot="breadcrumb">
      <a href="/model/">The AMBeR Model</a> / Step {step.data.number}
    </p>
    <div slot="art" class="step-art">
      <span class="big-number" aria-hidden="true">{step.data.number}</span>
      <Icon name={step.data.icon as IconName} size={180} />
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <div class="prose"><Content /></div>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <span class="eyebrow">Activities</span>
      <h2>Activities in step {step.data.number}</h2>
      <ol class="grid">
        {activities.map((a) => <ActivityCard activity={a} step={step} showStep={false} />)}
      </ol>
    </div>
  </section>

  {
    stories.length > 0 && (
      <section class="section">
        <div class="wrap">
          <span class="eyebrow">In practice</span>
          <h2>Stories related to this step</h2>
          <ul class="grid">
            {stories.map((story) => (
              <StoryCard story={story} />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <nav class="wrap pager" aria-label="Steps">
    {
      prev ? (
        <a href={`/model/${prev.id}/`}>
          <span class="eyebrow">← Previous step</span>
          {prev.data.number}. {prev.data.title}
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="next" href={`/model/${next.id}/`}>
          <span class="eyebrow">Next step →</span>
          {next.data.number}. {next.data.title}
        </a>
      )
    }
  </nav>
</Base>

<style>
  .step-art {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
  }
  .big-number {
    position: absolute;
    left: 10%;
    top: -1rem;
    font-size: 7rem;
    font-weight: 300;
    line-height: 1;
    color: var(--blue-light);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2.5rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--border);
  }
  .pager a {
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
  }
  .pager a:hover {
    color: var(--blue);
  }
  .next {
    text-align: right;
  }
</style>
