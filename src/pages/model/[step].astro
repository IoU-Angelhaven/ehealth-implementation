---
import { url } from '../../lib/url';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import StoryCard from '../../components/StoryCard.astro';
import Icon from '../../components/Icon.astro';
import KeyMessage from '../../components/KeyMessage.astro';
import type { IconName } from '../../icons';

export async function getStaticPaths() {
  const steps = (await getCollection('steps')).sort((a, b) => a.data.number - b.data.number);
  return steps.map((step, i) => ({
    params: { step: step.id },
    props: { step, prev: steps[i - 1], next: steps[i + 1] },
  }));
}

interface Props {
  step: CollectionEntry<'steps'>;
  prev?: CollectionEntry<'steps'>;
  next?: CollectionEntry<'steps'>;
}

const { step, prev, next } = Astro.props;
const { Content } = await render(step);
const hasBody = Boolean(step.body?.trim());
const { keyMessage } = step.data;
// Light grey and white sections alternate down the page
const activitiesTone = keyMessage ? '' : 'soft';
const storiesTone = keyMessage ? 'soft' : '';
const activities = (await getCollection('activities', (a) => a.data.step.id === step.id)).sort(
  (a, b) => a.data.order - b.data.order,
);
const stories = await getCollection(
  'stories',
  (s) => s.data.published && s.data.steps.some((ref) => ref.id === step.id),
);
---

<Base bare title={`Phase ${step.data.number}: ${step.data.title}`} description={step.data.summary}>
  <nav class="wrap top-pager" aria-label="Previous and next phase (top of page)">
    {
      prev && (
        <a href={url(`/model/${prev.id}/`)}>
          <span class="eyebrow">← Previous phase</span>
          {prev.data.number}. {prev.data.title}
        </a>
      )
    }
    {
      next && (
        <a class="next" href={url(`/model/${next.id}/`)}>
          <span class="eyebrow">Next phase →</span>
          {next.data.number}. {next.data.title}
        </a>
      )
    }
  </nav>
  <PageHero eyebrow={`Phase ${step.data.number} of 5`} title={step.data.title} lead={step.data.summary}>
    <p class="breadcrumb" slot="breadcrumb">
      <a href={url('/model/')}>The AMBeR Model</a> / Phase {step.data.number}
    </p>
    <div slot="art" class="step-art">
      <span class="big-number" aria-hidden="true">{step.data.number}</span>
      <Icon name={step.data.icon as IconName} size={180} />
    </div>
  </PageHero>

  {
    hasBody && (
      <section class="section">
        <div class="wrap">
          <div class="prose">
            <Content />
          </div>
        </div>
      </section>
    )
  }

  {
    keyMessage && (
      <section class="section soft">
        <div class="wrap">
          <KeyMessage text={keyMessage} />
        </div>
      </section>
    )
  }

  <section class={`section ${activitiesTone}`}>
    <div class="wrap">
      <span class="eyebrow">Activities</span>
      <h2>Activities in phase {step.data.number}</h2>
      <ol class="grid">
        {activities.map((a) => <ActivityCard activity={a} step={step} showStep={false} />)}
      </ol>
    </div>
  </section>

  {
    stories.length > 0 && (
      <section class={`section ${storiesTone}`}>
        <div class="wrap">
          <span class="eyebrow">In practice</span>
          <h2>Stories related to this phase</h2>
          <ul class="grid">
            {stories.map((story) => (
              <StoryCard story={story} />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <nav class="wrap pager" aria-label="Previous and next phase">
    {
      prev ? (
        <a href={url(`/model/${prev.id}/`)}>
          <span class="eyebrow">← Previous phase</span>
          {prev.data.number}. {prev.data.title}
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="next" href={url(`/model/${next.id}/`)}>
          <span class="eyebrow">Next phase →</span>
          {next.data.number}. {next.data.title}
        </a>
      )
    }
  </nav>
</Base>

<style>
  .step-art {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
  }
  .big-number {
    position: absolute;
    left: 10%;
    top: -1rem;
    font-size: 7rem;
    font-weight: 300;
    line-height: 1;
    color: var(--blue-light);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2.5rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--border);
  }
  .pager a,
  .top-pager a {
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
  }
  .pager a:hover,
  .top-pager a:hover {
    color: var(--blue);
  }
  /* Same links at the top right of the page */
  .top-pager {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem 2.5rem;
    padding-top: 1.75rem;
    margin-bottom: -1.5rem;
    font-size: 0.95rem;
  }
  .top-pager .eyebrow {
    margin-bottom: 0.15rem;
  }
  .next {
    text-align: right;
  }
</style>
