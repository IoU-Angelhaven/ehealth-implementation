---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
---

<Base bare title="Page not found">
  <PageHero title="Page not found" lead="The page you are looking for does not exist.">
    <p class="actions"><a class="button" href="/">Go to the start page</a></p>
    <Icon slot="art" name="compass" size={200} />
  </PageHero>
</Base>
