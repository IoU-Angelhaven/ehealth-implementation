---
// Short pointer under every checklist to the "Create your local guide" page.
import { url } from '../lib/url';
---

<aside class="checklist-note">
  <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
      <path d="M12 4v11M7 11l5 5 5-5M5 20h14"></path>
    </svg>
  </span>
  <p>
    Do you want to download the checklists and learn how to customize them for your own organisation?
    Go to <a href={url('/local-guide/')}>Create your local guide</a>.
  </p>
</aside>

<style>
  .checklist-note {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.75rem;
    padding: 1.1rem 1.4rem;
    background: var(--bg-soft);
    border-left: 5px solid var(--orange);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--blue-light);
    color: var(--ink);
  }
  p {
    margin: 0;
    font-size: 1.02rem;
  }
  a {
    font-weight: 700;
  }
</style>
