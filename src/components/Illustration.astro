---
// Decorative line illustrations in the site style (outline + coloured blocks).
interface Props {
  name: 'board' | 'path' | 'guide';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={['illustration', className]}
  viewBox="0 0 480 380"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === 'board' && (
      <Fragment>
        {/* planning board with sticky notes */}
        <rect class="fill-blue" x="70" y="72" width="300" height="200" stroke="none" opacity=".35" />
        <rect x="84" y="60" width="300" height="200" fill="#fff" />
        <path d="M150 260l-24 70M318 260l24 70M110 330h60M300 330h60" />
        <rect class="fill-blue" x="112" y="88" width="34" height="34" stroke="none" />
        <rect x="160" y="88" width="34" height="34" />
        <rect class="fill-orange" x="208" y="88" width="34" height="34" stroke="none" />
        <rect x="256" y="88" width="34" height="34" />
        <rect class="fill-blue" x="304" y="88" width="34" height="34" stroke="none" />
        <rect x="112" y="140" width="34" height="34" />
        <rect class="fill-blue" x="160" y="140" width="34" height="34" stroke="none" />
        <rect x="208" y="140" width="34" height="34" />
        <rect class="fill-orange" x="256" y="140" width="34" height="34" stroke="none" />
        <path d="M112 206h120M112 222h90M112 238h104" />
        {/* five connected steps */}
        <path d="M270 222h80" stroke-dasharray="4 6" />
        <circle class="fill-orange" cx="270" cy="222" r="9" stroke="none" />
        <circle cx="310" cy="222" r="9" fill="#fff" />
        <circle cx="350" cy="222" r="9" fill="#fff" />
        {/* document and pencil */}
        <rect class="fill-blue" x="372" y="150" width="70" height="92" stroke="none" />
        <path d="M384 140h52l14 14v92h-66z" fill="#fff" />
        <path d="M436 140v14h14M396 172h40M396 186h40M396 200h28M396 214h36" />
        <path d="M452 196l18-40 8 4-18 40-10 6z" fill="#fff" />
        {/* magnifier */}
        <circle class="fill-orange" cx="56" cy="214" r="22" stroke="none" opacity=".9" />
        <circle cx="64" cy="206" r="24" fill="#fff" fill-opacity=".6" />
        <path d="M81 223l26 26" stroke-width="4" />
      </Fragment>
    )
  }
  {
    name === 'path' && (
      <Fragment>
        {/* winding path through five steps */}
        <path d="M40 320C120 320 90 230 170 230s70-90 150-90 60-90 130-90" stroke-width="2" stroke-dasharray="2 10" />
        <rect class="fill-blue" x="20" y="300" width="44" height="44" stroke="none" />
        <circle cx="52" cy="318" r="18" fill="#fff" />
        <rect class="fill-orange" x="128" y="214" width="44" height="44" stroke="none" />
        <circle cx="160" cy="232" r="18" fill="#fff" />
        <rect class="fill-blue" x="228" y="168" width="44" height="44" stroke="none" />
        <circle cx="260" cy="186" r="18" fill="#fff" />
        <rect class="fill-orange" x="308" y="122" width="44" height="44" stroke="none" />
        <circle cx="340" cy="140" r="18" fill="#fff" />
        <rect class="fill-blue" x="398" y="34" width="44" height="44" stroke="none" />
        <circle cx="430" cy="52" r="18" fill="#fff" />
        <path d="M430 34V4l26 9-26 9" />
        <text x="52" y="324" text-anchor="middle" fill="currentColor" stroke="none" font-size="16" font-weight="700">1</text>
        <text x="160" y="238" text-anchor="middle" fill="currentColor" stroke="none" font-size="16" font-weight="700">2</text>
        <text x="260" y="192" text-anchor="middle" fill="currentColor" stroke="none" font-size="16" font-weight="700">3</text>
        <text x="340" y="146" text-anchor="middle" fill="currentColor" stroke="none" font-size="16" font-weight="700">4</text>
        <text x="430" y="58" text-anchor="middle" fill="currentColor" stroke="none" font-size="16" font-weight="700">5</text>
      </Fragment>
    )
  }
  {
    name === 'guide' && (
      <Fragment>
        {/* generic model document becoming a local guide */}
        <rect class="fill-blue" x="40" y="90" width="150" height="200" stroke="none" />
        <path d="M56 70h112l30 30v176H56z" fill="#fff" />
        <path d="M168 70v30h30M80 130h94M80 150h94M80 170h70M80 200h94M80 220h60" />
        <path d="M222 180h60" stroke-dasharray="4 6" />
        <path d="M272 168l14 12-14 12" />
        <rect class="fill-orange" x="300" y="110" width="150" height="200" stroke="none" />
        <path d="M316 90h112l30 30v176H316z" fill="#fff" />
        <path d="M428 90v30h30M340 150h94M340 170h50M340 200h94M340 220h76" />
        <rect class="fill-blue" x="396" y="164" width="38" height="12" stroke="none" />
        <path d="M340 248l8 8 14-16M372 252h60" />
      </Fragment>
    )
  }
</svg>

<style>
  .illustration {
    display: block;
    width: 100%;
    height: auto;
    color: var(--ink);
  }
  .fill-blue {
    fill: var(--blue-light);
  }
  .fill-orange {
    fill: var(--orange);
  }
</style>
