---
// Temporary visual of the five steps. Replace with the final model graphic when it is ready.
import { getCollection } from 'astro:content';

const steps = (await getCollection('steps')).sort((a, b) => a.data.number - b.data.number);
---

<ol class="model">
  {
    steps.map((step) => (
      <li>
        <a href={`/model/${step.id}/`}>
          <span class="num" aria-hidden="true">
            {step.data.number}
          </span>
          <span class="label">Step {step.data.number}</span>
          <span class="title">{step.data.title}</span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .model {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  li {
    position: relative;
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 1.25rem;
    background: #fff;
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition:
      transform 0.15s,
      border-color 0.15s;
  }
  a:hover {
    border-color: var(--blue);
    transform: translateY(-2px);
    color: var(--text);
  }
  .num {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    font-size: 1.2rem;
    font-weight: 800;
    box-shadow: 0 0 0 4px var(--blue-tint);
  }
  .label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .title {
    font-weight: 700;
    line-height: 1.3;
    color: var(--blue);
  }
  .arrow {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--orange-text);
    font-weight: 700;
  }
</style>
