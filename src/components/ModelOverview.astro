---
// Temporary visual of the five steps. Replace with the final model graphic when it is ready.
import { getCollection } from 'astro:content';

const steps = (await getCollection('steps')).sort((a, b) => a.data.number - b.data.number);
---

<ol class="model">
  {
    steps.map((step) => (
      <li>
        <a href={`/model/${step.id}/`}>
          <span class="num">{step.data.number}</span>
          <span class="title">{step.data.title}</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .model {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    counter-reset: none;
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1rem;
    background: var(--navy-700);
    color: #fff;
    text-decoration: none;
    border-radius: var(--radius);
    border-bottom: 4px solid var(--orange-light);
    transition: background 0.15s;
  }
  a:hover {
    background: var(--navy-500);
    color: #fff;
  }
  .num {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--orange-light);
    color: var(--navy-900);
    font-weight: 800;
  }
  .title {
    font-weight: 600;
    line-height: 1.3;
  }
</style>
