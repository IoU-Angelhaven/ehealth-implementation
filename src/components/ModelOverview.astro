---
// The five phases as a row of cards. Replace with the final model graphic when it is ready.
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import type { IconName } from '../icons';

const steps = (await getCollection('steps')).sort((a, b) => a.data.number - b.data.number);
const activities = await getCollection('activities');
---

<ol class="model">
  {
    steps.map((step, i) => {
      const count = activities.filter((a) => a.data.step.id === step.id).length;
      return (
        <li class="card tool-card">
          <span class="badge">Phase {step.data.number}</span>
          <Icon name={step.data.icon as IconName} size={72} accent={i % 2 ? 'orange' : 'blue'} />
          <h3>
            <a href={`/model/${step.id}/`}>{step.data.title}</a>
          </h3>
          <span class="count">
            {count} {count === 1 ? 'activity' : 'activities'}
          </span>
        </li>
      );
    })
  }
</ol>

<style>
  .model {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }
  .tool-card {
    min-height: 16rem;
    padding-top: 3rem;
  }
  .count {
    font-size: 0.85rem;
    color: var(--muted);
  }
  @media (max-width: 40rem) {
    .model {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
    .tool-card {
      min-height: auto;
      padding-top: 2.75rem;
    }
  }
</style>
