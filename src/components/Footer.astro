---
import { url } from '../lib/url';
import { site, nav, navCta } from '../site.config';
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="funding">
      <div class="logo-panel">
        <img
          src={url('/media/brand/amber-interreg-eu-stacked.svg')}
          alt="Interreg South Baltic. Co-funded by the European Union. AMBeR – Advanced Modelling of Baltic Cancer E-Care."
          width="193"
          height="85"
        />
      </div>
      <p>{site.fundingStatement}</p>
    </div>
    <nav aria-label="Footer">
      <h2>Explore</h2>
      <ul>
        {
          [...nav, navCta].map((item) => (
            <li>
              <a href={url(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="About this website">
      <h2>This website</h2>
      <ul>
        <li><a href={url('/privacy/')}>Privacy</a></li>
        <li><a href={url('/accessibility/')}>Accessibility</a></li>
        {site.contactEmail && <li><a href={`mailto:${site.contactEmail}`}>Contact</a></li>}
        <li><a href="https://southbaltic.eu/" rel="external">Interreg South Baltic Programme</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <p>{site.disclaimer}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #d5dbe3;
    padding: 4rem 0 2rem;
    font-size: 0.95rem;
  }
  .cols {
    display: grid;
    gap: 2rem 3rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 48rem) {
    .cols {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
  .logo-panel {
    display: inline-block;
    background: #fff;
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }
  .logo-panel img {
    display: block;
    width: 15rem;
    max-width: 100%;
  }
  .funding p {
    max-width: 30rem;
  }
  h2 {
    color: #fff;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    margin-bottom: 0.4rem;
  }
  a {
    color: #fff;
  }
  a:hover {
    color: var(--yellow);
  }
  .legal {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    font-size: 0.85rem;
    color: #b4bdc8;
  }
</style>
