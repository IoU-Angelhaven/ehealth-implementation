---
import { nav } from '../site.config';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <!-- Official AMBeR + Interreg South Baltic + EU logo combination. Programme rules
         (Communication Guidelines for Beneficiaries, sections 3.1 and 3.12.3 H):
         - the Programme logo must be prominent, at the top of the website;
         - the "Interreg + EU symbol" part must be at least 300 px wide on laptop/desktop
           screens. In this file that part is ~37 % of the full logo, so the logo is
           shown 820 px wide on large screens. Do not make it smaller or alter it. -->
    <a class="brand" href="/">
      <img
        src="/media/brand/amber-interreg-eu-horizontal.svg"
        alt="AMBeR – Advanced Modelling of Baltic Cancer E-Care. Interreg South Baltic. Co-funded by the European Union. Go to start page."
        width="308"
        height="55"
      />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" hidden>
      <span class="bars" aria-hidden="true"></span>
      Menu
    </button>
    <nav id="main-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Collapsible menu on small screens. Without JavaScript the menu is always shown.
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const header = document.querySelector('.site-header');
  if (button && header) {
    button.hidden = false;
    header.classList.add('js');
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      header.classList.toggle('open', !open);
    });
  }
</script>

<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid var(--border);
    box-shadow: 0 1px 0 rgb(0 34 102 / 0.04);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 1.25rem;
    padding-bottom: 0.75rem;
  }
  .brand {
    display: block;
    flex: 1 0 100%;
  }
  .brand img {
    display: block;
    height: auto;
    width: 51.25rem; /* 820 px, see comment above */
    max-width: 100%;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    color: var(--blue);
    font-weight: 600;
    text-decoration: none;
    padding: 0.4rem 0;
    border-bottom: 3px solid transparent;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--blue);
    border-bottom-color: var(--orange);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-weight: 700;
    color: var(--blue);
    background: var(--blue-tint);
    border: 0;
    border-radius: 999px;
    padding: 0.5rem 1rem;
    margin-left: auto;
    cursor: pointer;
  }
  .menu-toggle[hidden] {
    display: none;
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }
  .bars {
    position: relative;
  }
  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .bars::before {
    top: -6px;
  }
  .bars::after {
    top: 6px;
  }

  /* Small screens: menu collapses behind the button */
  @media (max-width: 63.99rem) {
    nav {
      flex-basis: 100%;
    }
    .js nav {
      display: none;
    }
    .js.open nav {
      display: block;
    }
    ul {
      flex-direction: column;
      gap: 0;
      border-top: 1px solid var(--border);
      padding-top: 0.5rem;
    }
    nav a {
      padding: 0.6rem 0;
      border-bottom: 0;
      border-left: 3px solid transparent;
      padding-left: 0.75rem;
    }
    nav a[aria-current='page'] {
      border-left-color: var(--orange);
    }
  }
  /* Large screens: menu always visible next to the logo */
  @media (min-width: 64rem) {
    .menu-toggle {
      display: none !important;
    }
    nav {
      flex-basis: 100%;
      border-top: 1px solid var(--border);
      padding-top: 0.5rem;
    }
  }
</style>
