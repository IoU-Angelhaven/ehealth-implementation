---
import { url, isCurrent } from '../lib/url';
import { nav, navCta } from '../site.config';
import LanguagePicker from './LanguagePicker.astro';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap">
    <!-- Official AMBeR + Interreg South Baltic + EU logo combination. Programme rules
         (Communication Guidelines for Beneficiaries, sections 3.1 and 3.12.3 H):
         - the Programme logo must be prominent, at the top of the website;
         - the "Interreg + EU symbol" part must be at least 300 px wide on laptop/desktop
           screens. In this file that part is ~37 % of the full logo, so the logo is
           shown 820 px wide on large screens. Do not make it smaller or alter it. -->
    <a class="brand" href={url('/')}>
      <img
        src={url('/media/brand/amber-interreg-eu-horizontal.svg')}
        alt="AMBeR – Advanced Modelling of Baltic Cancer E-Care. Interreg South Baltic. Co-funded by the European Union. Go to start page."
        width="308"
        height="55"
      />
    </a>
    <div class="navrow">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" hidden>
        <span class="bars" aria-hidden="true"></span>
        Menu
      </button>
      <nav id="main-nav" aria-label="Main">
        <ul>
          <li>
            <a href={url('/')} aria-current={isCurrent(path, '/', true) ? 'page' : undefined}>Home</a>
          </li>
          {
            nav.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={isCurrent(path, item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="cta">
            <a
              class="button"
              href={url(navCta.href)}
              aria-current={isCurrent(path, navCta.href) ? 'page' : undefined}
            >
              {navCta.label}
            </a>
          </li>
        </ul>
      </nav>
      <div class="lang-slot">
        <LanguagePicker />
      </div>
    </div>
  </div>
</header>

<script>
  // Collapsible menu on small screens. Without JavaScript the menu is always shown.
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const header = document.querySelector('.site-header');
  if (button && header) {
    button.hidden = false;
    header.classList.add('js');
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      header.classList.toggle('open', !open);
    });
  }
</script>

<style>
  .site-header {
    background: #fff;
    position: relative;
    z-index: 2;
  }
  .site-header > .wrap {
    padding-top: 1.5rem;
  }
  .brand {
    display: block;
    width: fit-content;
    max-width: 100%;
  }
  .brand img {
    display: block;
    height: auto;
    width: 51.25rem; /* 820 px, see comment above */
    max-width: 100%;
  }
  .navrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--border);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav {
    flex: 1 1 auto;
  }
  nav a:not(.button) {
    display: block;
    color: var(--ink);
    text-decoration: none;
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
  }
  nav a:not(.button):hover,
  nav a:not(.button)[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--orange);
  }
  .cta {
    margin-left: auto;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.45rem 0.9rem;
    cursor: pointer;
  }
  .menu-toggle[hidden] {
    display: none;
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
  }
  .bars {
    position: relative;
  }
  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .bars::before {
    top: -6px;
  }
  .bars::after {
    top: 6px;
  }

  @media (max-width: 69.99rem) {
    /* Language menu and Menu button side by side, the menu opens below */
    .lang-slot {
      order: 1;
    }
    .menu-toggle {
      order: 2;
      margin-left: 0;
    }
    nav {
      order: 3;
      flex-basis: 100%;
    }
    .js nav {
      display: none;
    }
    .js.open nav {
      display: block;
    }
    ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 0;
    }
    nav a:not(.button) {
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--border);
    }
    nav a:not(.button)[aria-current='page'] {
      border-bottom-color: var(--orange);
    }
    .cta {
      margin: 1rem 0 0;
    }
  }
  @media (min-width: 70rem) {
    .menu-toggle {
      display: none !important;
    }
  }
</style>
