---
import { site, nav } from '../site.config';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <!-- Replace with the AMBeR logo (place the file in public/media/) -->
      <span class="logo" aria-hidden="true">A</span>
      <span>
        <strong>{site.project}</strong>
        <span class="tagline">{site.name}</span>
      </span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--navy-900);
    color: #fff;
    border-bottom: 4px solid var(--orange-light);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #fff;
    text-decoration: none;
    line-height: 1.2;
  }
  .brand strong {
    display: block;
    font-size: 1.2rem;
    letter-spacing: 0.04em;
  }
  .tagline {
    font-size: 0.85rem;
    color: #c9d4e5;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 6px;
    background: var(--orange-light);
    color: var(--navy-900);
    font-weight: 800;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: #fff;
    text-decoration: none;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    border-bottom-color: var(--orange-light);
  }
</style>
