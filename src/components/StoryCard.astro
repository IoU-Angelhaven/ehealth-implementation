---
import { url } from '../lib/url';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  story: CollectionEntry<'stories'>;
}
const { story } = Astro.props;
---

<li class="card story">
  {
    story.data.image ? (
      <img class="thumb" src={url(story.data.image)} alt="" loading="lazy" />
    ) : (
      <div class="thumb placeholder">
        <Icon name="chat" size={72} accent="orange" />
      </div>
    )
  }
  <span class="eyebrow">{story.data.country} · {story.data.organisation}</span>
  <h3><a href={url(`/stories/${story.id}/`)}>{story.data.title}</a></h3>
  <p>{story.data.summary}</p>
</li>

<style>
  .story {
    padding-top: 0;
  }
  .thumb {
    display: block;
    width: calc(100% + 3.5rem);
    max-width: none;
    margin: 0 -1.75rem 1.5rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .placeholder {
    display: grid;
    place-items: center;
    background: var(--blue-tint);
  }
</style>
