---
// Highlighted "Key message" with an orange illustration pointing at the text.
// It has no box of its own: the page puts it in a light grey full-width section.
interface Props {
  text: string;
  title?: string;
  id?: string;
}
const { text, title = 'Key message', id = 'key-message' } = Astro.props;
const paragraphs = text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<aside class="important" role="note" aria-labelledby={id}>
  <svg class="art" viewBox="0 0 160 120" aria-hidden="true" focusable="false">
    <!-- emphasis rays -->
    <g class="orange-line" fill="none" stroke-width="3" stroke-linecap="round">
      <path d="M66 3v8M38 12l5 6M94 12l-5 6"></path>
    </g>
    <!-- coloured block behind -->
    <circle class="orange-fill" cx="54" cy="72" r="38"></circle>
    <!-- warning sign -->
    <path
      d="M66 22 112 100H20Z"
      fill="#fff"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linejoin="round"></path>
    <path d="M66 50v24" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path>
    <circle cx="66" cy="87" r="3.5" fill="currentColor"></circle>
    <!-- arrow pointing at the text -->
    <g class="arrow orange-line" fill="none" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M122 60h30M141 49l11 11-11 11"></path>
    </g>
  </svg>
  <div class="text">
    <h2 class="eyebrow" id={id}>{title}</h2>
    {paragraphs.map((p) => <p>{p}</p>)}
  </div>
</aside>

<style>
  .important {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 2rem;
    align-items: center;
    max-width: 52rem;
  }
  .art {
    width: 9rem;
    height: auto;
    color: var(--ink);
  }
  .orange-fill {
    fill: var(--orange);
  }
  .orange-line {
    stroke: var(--orange);
  }
  /* The label itself uses the global .eyebrow style (small, bold capitals), as on the other phase pages */
  h2 {
    margin: 0 0 0.5rem;
  }
  p {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
  }
  p:last-child {
    margin-bottom: 0;
  }
  @media (min-width: 40rem) {
    .important {
      grid-template-columns: 10rem 1fr;
    }
    .art {
      width: 10rem;
    }
  }
  /* On small screens the box is stacked: hide the sideways arrow */
  @media (max-width: 39.99rem) {
    .arrow {
      display: none;
    }
  }
</style>
